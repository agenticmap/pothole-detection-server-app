# ─────────────────────────────────────────────────────────────────────────────
# Pothole Detection Server — Environment Variables
# Copy this to .env and fill in values for local development.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker Compose (default for development):
# NOTE: docker-compose.yml maps host 5433 -> container 5432.
DATABASE_URL=postgresql://pothole:pothole@localhost:5433/pothole_db

# Supabase (production) — use the "Transaction" pooler connection string:
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Disable asyncpg statement cache for pgbouncer/Supabase pooler compatibility.
# Set to "true" when connecting through Supabase's connection pooler.
DATABASE_USE_POOLER=false

# ── Storage ───────────────────────────────────────────────────────────────────
# Where to store uploaded JPEG frames: "local" or "supabase"
STORAGE_BACKEND=local

# Local storage path (relative to server root, used when STORAGE_BACKEND=local)
STORAGE_LOCAL_PATH=./storage/frames

# Supabase Storage (used when STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=frames

# ── Server ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment: development | staging | production
# KEEP development locally: migrations only run in development mode.
ENV=development

# Root logger level (applied by app/main.py).
LOG_LEVEL=INFO

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Sized for a real collection drive; 100/hour 429s mid-drain.
RATE_LIMIT_EVENTS_PER_HOUR=5000
RATE_LIMIT_FRAMES_PER_HOUR=5000

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Maximum number of events in a single POST /api/v1/events batch
MAX_BATCH_SIZE=100

# Maximum JPEG frame upload size in bytes (10 MB)
MAX_FRAME_SIZE_BYTES=10485760

# ── Server-side detection (Phase 2.3) ──────────────────────────────────────────
# Gated off until a model is configured. Backend: none | onnx | http | hybrid
DETECTION_ENABLED=false
DETECTION_BACKEND=none
# onnx backend: path to an Ultralytics .onnx export. Must be the RAW export
# (opset=12, nms=False) — a graph with NMS baked in is rejected at decode time.
DETECTION_MODEL_PATH=
DETECTION_MODEL_ID=yolov8s_pothole_v1
DETECTION_CONF_THRESHOLD=0.25
DETECTION_IOU_THRESHOLD=0.45

# Class map (Phase 2.7b). Position IS the class_id, so this must match the model's
# data.yaml `names:` in order -- the decoder refuses to start otherwise, because a
# mismatch would mislabel every box and could source the frame probability from the
# wrong class. Only DETECTION_PRIMARY_CLASS_ID feeds server_probability and therefore
# fusion; fusion has no notion of class and would read a manhole as a pothole.
# Single-class models (v1/v2/v3): leave as `pothole`.
# Multi-class Model A (v4+):      pothole,manhole,grate,patch,crack
DETECTION_CLASS_NAMES=pothole
DETECTION_PRIMARY_CLASS_ID=0
# http backend: external GPU inference endpoint (POST jpeg → {probability, detections})
DETECTION_HTTP_URL=
DETECTION_HTTP_TIMEOUT=30.0

# ROI crop (Phase 2.7) — fractions of frame HEIGHT, full width always kept.
# Real uploads are 480x640 portrait windshield frames: sky and trees fill the top
# half, the hood the bottom ~15%. Cropping to the road band before letterboxing
# puts ~1.8x more pixels on road surface. Detections are returned in full-frame
# coordinates regardless, so flipping this changes accuracy, not the contract.
DETECTION_ROI_ENABLED=true
DETECTION_ROI_TOP=0.45
DETECTION_ROI_BOTTOM=0.90

# ── Hybrid detector (YOLO Stage 1 + VLM verifier) ──────────────────────────────
# backend=hybrid runs a Stage-1 detector and asks a VLM to confirm only the
# AMBIGUOUS frames (gray zone), rejecting shadows/manholes/wet patches/markings.
DETECTION_HYBRID_STAGE1=onnx          # which detector Stage 1 uses: onnx | http
# NOT detector thresholds. These gate when a VLM call is worth paying for, and
# were never calibrated against the YOLO detector. Reusing them to decide which
# frames a human reviews would discard ~85% of true positives: the detector's
# scores top out around 0.69 and its useful range is 0.05-0.30. See
# docs/phases/phase-2.7c-public-data.md.
VLM_VERIFY_LOW=0.40                   # below this Stage-1 prob → trust Stage 1 (no VLM)
VLM_VERIFY_HIGH=0.75                  # above this → trust Stage 1 (no VLM)
VLM_CROP_TO_DETECTIONS=true           # crop to the detection bbox before the VLM call
VLM_CROP_MARGIN=0.20
VLM_BLEND_WEIGHT=0.7                  # VLM weight in the logit blend (0..1)
VLM_MAX_CALLS_PER_RUN=50              # per-run cap on VLM calls (bounds cost)

# Pluggable VLM verifier — provider-agnostic (cloud + local). Pick ONE:
#   ollama      → local, free, nothing leaves the host. No key. Default URL
#                 http://localhost:11434/v1/chat/completions. `ollama pull qwen2.5vl:7b`
#   openrouter  → one key, any hosted VLM. Needs VLM_API_KEY. Default URL
#                 https://openrouter.ai/api/v1/chat/completions
#   claude      → Anthropic vision (needs `anthropic`; VLM_API_KEY or ANTHROPIC_API_KEY)
#   gemini      → Gemini 2.5 Flash (needs `google-genai`)
#   local_http  → any other OpenAI-compatible endpoint (vLLM/LM Studio) — VLM_HTTP_URL required
# ollama/openrouter/local_http share one stdlib-urllib client: no extra pip install.
#
# PRIVACY: openrouter/claude/gemini send road imagery to a third party. Frames are
# EXIF-stripped on ingest, but pixels can still hold plates and faces. For a
# municipal deployment prefer ollama; see docs/phases/phase-2.9-vlm-verification.md.
VLM_BACKEND=none
# Model id; backend picks a default if empty. Claude default is claude-opus-4-8 —
# for a high-volume crowd app set a cheaper vision tier (claude-sonnet-4-6 or
# claude-haiku-4-5). Gemini default gemini-2.5-flash; ollama/local_http default
# qwen2.5-vl. For openrouter use a fully-qualified id, e.g. qwen/qwen2.5-vl-72b-instruct.
VLM_MODEL_ID=
VLM_API_KEY=
VLM_HTTP_URL=                          # overrides the backend default URL; required for local_http
VLM_TIMEOUT=30.0
VLM_JSON_MODE=true                     # send response_format=json_object; set false if a model rejects it
# OpenRouter-only attribution headers. Optional, ignored by every other backend.
VLM_HTTP_REFERER=
VLM_HTTP_TITLE=

# ── Pairing search (Phase 2.2d) ───────────────────────────────────────────────
# Which frame gets attached to which sensor event. The camera sees a pothole while
# it is still AHEAD of the car; the accelerometer fires when the wheel arrives. So
# the right frame has a NON-ZERO separation and a NEGATIVE delta_ms -- not the
# delta=0/dist=0 the old ranking preferred. Re-ranking pothole_db's existing
# candidates changed the winner for 713 of 2197 frames (32.5%).
# Setting this false restores the pre-2.2d RANKING but not the old windows -- it
# still uses FUSION_WINDOW_M and a fixed FUSION_WINDOW_MS_MAX. For a byte-exact
# revert also set FUSION_WINDOW_M=25 and FUSION_WINDOW_MS_MAX=3000 (the old
# defaults).
FUSION_PAIRING_COST_ENABLED=true
# Ground-distance band the camera can resolve a pothole in -- a property of the lens
# and mount pitch. THESE ARE A HYPOTHESIS, NOT A FINDING: only 3 potholes in
# pothole_db have a paired frame. Replace with `python scripts/pairing_eval.py
# --fit-lead` once Phase 2.7's frame labels exist.
FUSION_LEAD_NEAR_M=5.0
FUSION_LEAD_FAR_M=30.0
# Divisor floor when turning a lead distance into an expected time offset.
FUSION_SPEED_FLOOR_MPS=5.0
# Spatial window; must span the lead band plus GPS error. 25 m reached 1842 frames,
# 40 m reaches 2197 (+19.3%).
FUSION_WINDOW_M=40.0
# The temporal window is DERIVED from speed (window_m / speed), so the two gates are
# one constraint. This is only the ceiling, for the low-speed case. NOTE: this
# replaces FUSION_WINDOW_MS, which no longer exists.
FUSION_WINDOW_MS_MAX=8000
# Cost weights: lead_penalty is metres outside the band, kinematic is seconds of
# residual. forward_penalty is charged to a frame taken AFTER the event fired.
FUSION_W_LEAD=1.0
FUSION_W_KINEMATIC=1.0
FUSION_FORWARD_PENALTY=2.0
# Hold an unpaired frame back this long before giving up on it, so an event that
# uploads after its frame can still pair. Observations lag frames by ~1.5 h median.
FUSION_RETRY_GRACE_MINUTES=30

# Frame-only cluster members -- a pothole the camera saw but nobody drove over.
# 98.6% of pothole events have no coincident frame, so this is the biggest recall
# ceiling in the pipeline. LEAVE IT OFF until Phase 2.7 ships a model: without one,
# server_probability is NULL everywhere and the only input is the on-device
# probability, whose floor was lowered to ~5% mid-collection (p50 0.118).
FUSION_FRAME_ONLY_ENABLED=false
FUSION_FRAME_ONLY_MIN_PROBABILITY=0.5

# ── Clustering (Phase 2.2) ────────────────────────────────────────────────────
# Clusters go public only once this many distinct devices contribute.
# Set to 1 for solo test drives; 2+ for real crowd deployments.
CLUSTER_MIN_DISTINCT_DEVICES=2

# ── Spatiotemporal crowd fusion (Phase 2.2c) ──────────────────────────────────
# Cluster confidence becomes a spatiotemporally weighted combination of its members'
# class distributions instead of a plain mean: a detection on the centroid seen today
# outweighs one 20 m away from three weeks ago. Safe to leave on -- clusters whose
# members predate the sensor_class_probs column keep the old mean.
CLUSTER_SPATIOTEMPORAL_ENABLED=true
# RBF sigma floors. gamma = 1/(2*sigma^2) with sigma from the cluster's own spread,
# so without a floor a cluster of near-identical members divides by zero.
CLUSTER_RBF_SIGMA_FLOOR_M=1.0
CLUSTER_RBF_SIGMA_FLOOR_SECONDS=3600.0
# Symmetric Dirichlet prior. 0.0 reproduces the published method exactly. Above zero,
# small clusters shrink toward uniform and only reach their observed value as
# corroborating members accumulate -- i.e. this is what makes three agreeing devices
# outrank one. An extension beyond the paper; see docs/phases/phase-2.2c-spatiotemporal-fusion.md.
CLUSTER_PRIOR_CONCENTRATION=0.0
# Keep opposing carriageways as separate defects. Members of one spatial group are
# split into direction sub-groups when their headings differ by more than this.
CLUSTER_BEARING_AWARE=true
CLUSTER_BEARING_TOLERANCE_DEG=45.0

# ── Staff auth (Phase 2.4) ────────────────────────────────────────────────────
AUTH_ENABLED=true

# RS256 signing key for staff access tokens. LEAVE EMPTY AND THE SERVER GENERATES AN
# EPHEMERAL KEYPAIR PER PROCESS — tokens then die on every reload, and because the
# Dockerfile runs `uvicorn --workers 2` each worker signs with a *different* key, so
# a token minted by one worker fails validation on the other. That surfaces as
# intermittent 401s that look like a client bug. Set it for anything but throwaway
# single-worker dev; outside ENV=development the server refuses to start without it.
#
# Generate (PKCS#8, unencrypted — what app/auth/keys.py expects):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# Then flatten to one line; literal \n escapes are accepted:
#   awk 'BEGIN{ORS="\n"} {print}' key.pem
AUTH_JWT_PRIVATE_KEY_PEM=
# Derived from the private key when empty — you normally never set this.
AUTH_JWT_PUBLIC_KEY_PEM=
AUTH_JWT_KID=auth-key-1
AUTH_JWT_ISSUER=pothole-detection-server
AUTH_ACCESS_TOKEN_TTL_MINUTES=30
AUTH_REFRESH_TOKEN_TTL_DAYS=30
