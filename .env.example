# ─────────────────────────────────────────────────────────────────────────────
# Pothole Detection Server — Environment Variables
# Copy this to .env and fill in values for local development.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker Compose (default for development):
DATABASE_URL=postgresql://pothole:pothole@localhost:5432/pothole_db

# Supabase (production) — use the "Transaction" pooler connection string:
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Disable asyncpg statement cache for pgbouncer/Supabase pooler compatibility.
# Set to "true" when connecting through Supabase's connection pooler.
DATABASE_USE_POOLER=false

# ── Storage ───────────────────────────────────────────────────────────────────
# Where to store uploaded JPEG frames: "local" or "supabase"
STORAGE_BACKEND=local

# Local storage path (relative to server root, used when STORAGE_BACKEND=local)
STORAGE_LOCAL_PATH=./storage/frames

# Supabase Storage (used when STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=frames

# ── Server ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment: development | staging | production
ENV=development

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_EVENTS_PER_HOUR=100
RATE_LIMIT_FRAMES_PER_HOUR=100

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Maximum number of events in a single POST /api/v1/events batch
MAX_BATCH_SIZE=100

# Maximum JPEG frame upload size in bytes (10 MB)
MAX_FRAME_SIZE_BYTES=10485760
