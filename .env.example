# ─────────────────────────────────────────────────────────────────────────────
# Pothole Detection Server — Environment Variables
# Copy this to .env and fill in values for local development.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker Compose (default for development):
# NOTE: docker-compose.yml maps host 5433 -> container 5432.
DATABASE_URL=postgresql://pothole:pothole@localhost:5433/pothole_db

# Supabase (production) — use the "Transaction" pooler connection string:
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Disable asyncpg statement cache for pgbouncer/Supabase pooler compatibility.
# Set to "true" when connecting through Supabase's connection pooler.
DATABASE_USE_POOLER=false

# ── Storage ───────────────────────────────────────────────────────────────────
# Where to store uploaded JPEG frames: "local" or "supabase"
STORAGE_BACKEND=local

# Local storage path (relative to server root, used when STORAGE_BACKEND=local)
STORAGE_LOCAL_PATH=./storage/frames

# Supabase Storage (used when STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=frames

# ── Server ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment: development | staging | production
# KEEP development locally: migrations only run in development mode.
ENV=development

# Root logger level (applied by app/main.py).
LOG_LEVEL=INFO

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Sized for a real collection drive; 100/hour 429s mid-drain.
RATE_LIMIT_EVENTS_PER_HOUR=5000
RATE_LIMIT_FRAMES_PER_HOUR=5000

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Maximum number of events in a single POST /api/v1/events batch
MAX_BATCH_SIZE=100

# Maximum JPEG frame upload size in bytes (10 MB)
MAX_FRAME_SIZE_BYTES=10485760

# ── Server-side detection (Phase 2.3) ──────────────────────────────────────────
# Gated off until a model is configured. Backend: none | onnx | http | hybrid
DETECTION_ENABLED=false
DETECTION_BACKEND=none
# onnx backend: path to a YOLOv8/RF-DETR .onnx export
DETECTION_MODEL_PATH=
DETECTION_MODEL_ID=yolov8s_pothole_v1
# http backend: external GPU inference endpoint (POST jpeg → {probability, detections})
DETECTION_HTTP_URL=

# ── Hybrid detector (YOLO Stage 1 + VLM verifier) ──────────────────────────────
# backend=hybrid runs a Stage-1 detector and asks a VLM to confirm only the
# AMBIGUOUS frames (gray zone), rejecting shadows/manholes/wet patches/markings.
DETECTION_HYBRID_STAGE1=onnx          # which detector Stage 1 uses: onnx | http
VLM_VERIFY_LOW=0.40                   # below this Stage-1 prob → trust Stage 1 (no VLM)
VLM_VERIFY_HIGH=0.75                  # above this → trust Stage 1 (no VLM)
VLM_CROP_TO_DETECTIONS=true           # crop to the detection bbox before the VLM call
VLM_CROP_MARGIN=0.20
VLM_BLEND_WEIGHT=0.7                  # VLM weight in the logit blend (0..1)
VLM_MAX_CALLS_PER_RUN=50              # per-run cap on VLM calls (bounds cost)

# Pluggable VLM verifier — provider-agnostic (cloud + local):
#   claude      → Anthropic vision (needs `anthropic`; VLM_API_KEY or ANTHROPIC_API_KEY)
#   gemini      → Gemini 2.5 Flash (needs `google-genai`; cheapest/fastest cloud)
#   local_http  → OpenAI-compatible endpoint (vLLM/Ollama/LM Studio; Qwen2.5-VL/LLaVA)
VLM_BACKEND=none
# Model id; backend picks a default if empty. Claude default is claude-opus-4-8 —
# for a high-volume crowd app set a cheaper vision tier (claude-sonnet-4-6 or
# claude-haiku-4-5). Gemini default gemini-2.5-flash; local_http default qwen2.5-vl.
VLM_MODEL_ID=
VLM_API_KEY=
VLM_HTTP_URL=                          # e.g. http://localhost:11434/v1/chat/completions
VLM_TIMEOUT=30.0

# ── Clustering (Phase 2.2) ────────────────────────────────────────────────────
# Clusters go public only once this many distinct devices contribute.
# Set to 1 for solo test drives; 2+ for real crowd deployments.
CLUSTER_MIN_DISTINCT_DEVICES=2
