{
  "name": "pothole-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Operator dashboard for the pothole-detection server (Phase 2.5).",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs && node scripts/build-guide.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && node scripts/build-guide.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "maplibre-gl": "^6.4.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.2.1",
    "marked": "^18.0.11",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
