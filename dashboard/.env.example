# Dashboard build-time settings. Copy to `dashboard/.env`.
#
# Vite reads .env from THIS directory, not the repo root, so VITE_* keys placed
# in the server's ../.env are silently ignored. The real .env is gitignored
# (the root .gitignore's bare `.env` pattern matches at any depth), which is why
# this example is tracked -- otherwise a fresh clone gets the built-in defaults
# with nothing to say so.

# Initial map view. There is no extent endpoint, so this is configured rather
# than discovered: get it wrong and the operator opens onto empty ocean with an
# honest-looking "No potholes in this view" banner.
#
# The built-in default is 43.6532,-79.3832 -- downtown Toronto, and also the
# coordinate the test fixtures use.
#
# Pick the densest CLUSTER cell, not the observation centroid: a drive is a long
# corridor, so its centroid usually falls in a gap with an empty tile.
#   SELECT ST_SnapToGrid(centroid::geometry, 0.01), count(*)
#   FROM asset_cluster GROUP BY 1 ORDER BY 2 DESC LIMIT 1;
VITE_MAP_LAT=43.81
VITE_MAP_LON=-79.43

# Keep above 12: the tile endpoint switches to aggregate bins at
# TILE_AGGREGATE_MAX_ZOOM=12, so individual clickable clusters need z >= 13.
VITE_MAP_ZOOM=13

# Where the API is during `npm run dev` (proxied, so no CORS preflight per tile).
# Unused by `npm run build`, which is served same-origin from /dashboard.
VITE_API_TARGET=http://127.0.0.1:8000

# PMTiles basemap archive. Served unauthenticated over HTTP Range from
# storage/basemap/ -- see dashboard/README.md for how to regenerate it.
VITE_BASEMAP_URL=/basemap/toronto.pmtiles
