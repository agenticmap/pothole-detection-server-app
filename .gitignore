# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables (secrets)
.env

# Local frame storage
storage/
test_storage/

# Machine-specific local Claude settings (keeps absolute paths out of the repo)
.claude/settings.local.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# pytest
.pytest_cache/

# ruff
.ruff_cache/

# Distribution
dist/
*.egg-info/

# Dashboard frontend (Phase 2.5)
node_modules/
*.tsbuildinfo
.env.local

# Playwright MCP scratch output
.playwright-mcp/

# Training datasets. Multi-GB archives that GitHub rejects outright (100 MB/file
# limit) and that bloated history until they were stripped. Keep them on disk;
# they are inputs to model training, not source. The MATLAB research code in
# files/MatlabCode/ stays tracked.
files/*.zip

# Model artifacts and training scratch (Phase 2.7). The server loads an ONNX export
# from models/ via DETECTION_MODEL_PATH; it is a build output, not source, and .onnx
# weights are tens of MB. Ultralytics writes checkpoints and plots to runs/.
# Extract the files/*.zip datasets OUTSIDE this repo -- the ignore above covers the
# archives, not the ~10,700 files they unpack into.
models/*
!models/README.md
runs/
*.onnx
*.pt
.venv-train/
*.docx